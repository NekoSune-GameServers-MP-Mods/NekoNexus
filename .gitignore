# Based on https://raw.githubusercontent.com/github/gitignore/main/Node.gitignore

# Logs

logs
_.log
npm-debug.log_
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Caches

.cache

# Diagnostic reports (https://nodejs.org/api/report.html)

report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# Runtime data

pids
_.pid
_.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover

lib-cov

# Coverage directory used by tools like istanbul

coverage
*.lcov

# nyc test coverage

.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)

.grunt

# Bower dependency directory (https://bower.io/)

bower_components

# node-waf configuration

.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)

build/Release

# Dependency directories

node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)

web_modules/

# TypeScript cache

*.tsbuildinfo

# Optional npm cache directory

.npm

# Optional eslint cache

.eslintcache

# Optional stylelint cache

.stylelintcache

# Microbundle cache

.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history

.node_repl_history

# Output of 'npm pack'

*.tgz

# Yarn Integrity file

.yarn-integrity

# dotenv environment variable files

.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)

.parcel-cache

# Next.js build output

.next
out

# Nuxt.js build / generate output

.nuxt
dist

# Gatsby files

# Comment in the public line in if your project uses Gatsby and not Next.js

# https://nextjs.org/blog/next-9-1#public-directory-support

# public

# vuepress build output

.vuepress/dist

# vuepress v2.x temp and cache directory

.temp

# Docusaurus cache and generated files

.docusaurus

# Serverless directories

.serverless/

# FuseBox cache

.fusebox/

# DynamoDB Local files

.dynamodb/

# TernJS port file

.tern-port

# Stores VSCode versions used for testing VSCode extensions

.vscode-test

# yarn v2

.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# NekoNexus
.vscode/
__pycache__/
.old/
build/
*.old/
**/wwwroot/updates
migration

.release

bin
obj
packages/AssemblyReferences/**/*.dll
packages/Realtime/photon/*
*.csproj.user
*.DotSettings.user
.vs

# ---------------------------------------------------------------------------
# NekoNexus — .NET, build output, secrets (added for the free-server build)
# ---------------------------------------------------------------------------

# .NET build intermediates / output
**/bin/
**/obj/
*.user
*.suo
.vs/

# Built release bundles (regenerated by the bundle scripts)
.release/

# Shim DLLs are build artifacts (regenerated by the shim builds in shims/)
packages/AssemblyReferences/*.dll
packages/AssemblyReferences/4.7.1/*.dll
packages/Core/AssemblyReferences/*.dll

# Vendored LiteNetLib keeps source only (no nested git)
shims/_vendor/**/.git/

# Local config & secrets — NEVER commit these
.env
*.env
!*.env.example
admin.config.yml
packages/admin/admin.config.yml
packages/admin/server-config.json
packages/admin/.nekopay.env
docker/config/*.local.yml

# Bun
.bun/

# Patcher is a git submodule (festivaldev/UniversalUnityPatcher) — cloned at build time, not inlined
packages/Patcher/
# conntest dev tool: copied transport dll (build artifact)
misc/conntest/*.dll

# Bun compile temp artifacts
*.bun-build

# admin test/run output
packages/admin/*.out
packages/admin/*.err

# Published client auto-update payloads (generated by misc/publish-update.ps1; served via volume)
server-data/
